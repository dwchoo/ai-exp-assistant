      "id": "G4-LIFETIME-IDENTITY-FALSE-PASS",
      "location": "tests/gates/g4_lifetime/live_detach_probe.py:run",
      "evidence": "Frontend protocol doubles returned passed with same manager/worker PID, same parent/supervisor PID, substituted backend PID differing from Popen.pid, or missing worker PID. The otherwise-valid evidence preserves all before/detached/after values; equality alone is insufficient.",
      "test": "LifetimeEvidenceBoundaryTests.test_distinct_and_bound_process_identities_are_required",
      "failing_subcases": 4,
      "required_boundary": "Exactly distinct valid backend/OMP/parent/supervisor/experiment identities, actual backend PID binding."
    },
    {
      "id": "G4-LIFETIME-LEASE-FALSE-PASS",
      "location": "tests/gates/g4_lifetime/live_detach_probe.py:run",
      "evidence": "Passed despite detached.attached=true or reattached.attached=false.",
      "test": "LifetimeEvidenceBoundaryTests.test_frontend_detach_and_reattach_must_really_change_display_lease",
      "failing_subcases": 2,
      "required_boundary": "Actual detach and reattach lease states, not identity equality alone."
    },
    {
      "id": "G4-LIFETIME-RESIDUE-MASKING",
      "location": "tests/gates/g4_lifetime/live_detach_probe.py:run",
      "evidence": "A real test-owned sleep process remained alive and was explicitly named in backend_cleanup.owned_pids; empty residue=[] still yielded passed. The adversarial sleep was terminated/waited in finally.",
      "test": "LifetimeEvidenceBoundaryTests.test_live_owned_residue_cannot_be_masked_by_empty_backend_residue_flag",
      "required_boundary": "Independent OS cleanup verification instead of trusting an empty residue field."
    },
    {
      "id": "G4-EVIDENCE-EMPTY-REQUIRED-CONTEXT",
      "location": "tests/gates/harness/aggregate.py:validate",
      "evidence": "With empty required items/evidence context, validate([], expected=context) returns [] without rejection.",
      "test": "AggregateAdversarialTests.test_empty_required_context_cannot_be_a_gate_certificate",
      "required_boundary": "Invalid empty verifier context cannot certify the approved required gate set."
    },
    {
      "id": "G4-EVIDENCE-EMPTY-SCHEMA-ONLY",
      "location": "tests/gates/harness/aggregate.py:validate",
      "evidence": "All 25 records are accepted with their pinned evidence file empty or containing only schemaVersion, despite runtime item labels; digests match the intentionally invalid pinned context.",
      "test": "AggregateAdversarialTests.test_empty_or_schema_only_pinned_evidence_is_not_observed_runtime_evidence",
      "failing_subcases": 2,
      "required_boundary": "Reject empty/schema-only certificates at the verifier-context/evidence boundary. Do not mistake provenance-only fixture validation for runtime semantics."
    }
